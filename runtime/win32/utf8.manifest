<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- UTF-8 as the program's code page (Windows 10 1903 and later): paths with any letters in them reach the C library's
     file functions and the -A Windows functions as they are. Linked into witch-time-game.exe and the launcher. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
